# Copy to .env. Never commit real credentials.
PROXY_API_BASE=https://proxyapi.pekpik.com
PRIVATE_READER_API_KEY=
SHARED_PROXY_USERNAME=
SHARED_PROXY_PASSWORD=
DEFAULT_PROXY_PROFILE=private
PROXY_STICKY_SECONDS=300
PROXY_SELECTION_WINDOW=20
ROBOTS_BYPASS_DOMAINS=

DATABASE_URL=postgresql://realtime:change-me@postgres:5432/realtime
VALKEY_URL=redis://valkey:6379/0
CRAWLER_SLOTS=2
CRAWLER_CONCURRENCY=32
CRAWLER_CONCURRENCY_PER_DOMAIN=4
CRAWLER_DOWNLOAD_DELAY=0.1
CRAWLER_AUTOTHROTTLE_TARGET=3
CRAWLER_DEPTH_LIMIT=12
DISCOVERY_PAGES=10
MAX_LINKS_PER_PAGE=100
