# Copy to .env. Never commit real credentials.
PROXY_API_BASE=https://proxyapi.pekpik.com
PRIVATE_READER_API_KEY=
SHARED_PROXY_USERNAME=
SHARED_PROXY_PASSWORD=
DEFAULT_PROXY_PROFILE=private
PROXY_STICKY_SECONDS=0
GOOGLE_PROXY_STICKY_SECONDS=0
PROXY_SELECTION_WINDOW=160
PROXY_SORT=quality
ROBOTS_BYPASS_DOMAINS=
CRAWLER_OBEY_ROBOTS=false

DATABASE_URL=postgresql://realtime:change-me@postgres:5432/realtime
VALKEY_URL=redis://valkey:6379/0
CRAWLER_SLOTS=2
CRAWLER_CONCURRENCY=144
CRAWLER_CONCURRENCY_PER_DOMAIN=4
CRAWLER_DOWNLOAD_DELAY=0.1
CRAWLER_AUTOTHROTTLE_ENABLED=true
CRAWLER_AUTOTHROTTLE_TARGET=8
CRAWLER_RETRY_HTTP_CODES=408,425,429,500,502,503,504
CRAWLER_DEPTH_LIMIT=12
CRAWLER_MIN_CONTENT_CHARS=100
BROWSER_FALLBACK_ENABLED=true
BROWSER_FALLBACK_RATIO=0.05
BROWSER_MAX_PAGES=2
BROWSER_TIMEOUT_MS=15000
DISCOVERY_PAGES=20
DISCOVERY_GLOBAL_CONCURRENCY=24
DISCOVERY_QUERY_CONCURRENCY=4
DISCOVERY_HISTORY_START=2015-01-01
DISCOVERY_WINDOW_DAYS=7
DISCOVERY_MIN_NOVELTY_RATIO=0.05
DISCOVERY_EXHAUSTED_COOLDOWN_SECONDS=21600
MAX_LINKS_PER_PAGE=100
TRAFILATURA_ENABLED=true
GOOGLE_WEB_ENABLED=true
# Free providers, in failover order. No search API key required.
GOOGLE_FREE_PROVIDERS=wml,wml_direct,searxng
SEARXNG_URL=http://searxng:8080
GOOGLE_WEB_DEEP_CACHE_SECONDS=86400
GOOGLE_WEB_INITIAL_RPS=0.5
GOOGLE_WEB_MAX_RPS=2
GOOGLE_WEB_BURST=1
GOOGLE_WEB_MAX_PAGES=11
GOOGLE_WEB_PAGES_PER_BATCH=3
GOOGLE_WEB_QUERY_CACHE_SECONDS=21600
GOOGLE_WEB_PROXY_MIN_INTERVAL_SECONDS=30
GOOGLE_WEB_PROXY_COOLDOWN_SECONDS=21600
GOOGLE_WEB_SOURCE_COOLDOWN_SECONDS=1800
GOOGLE_WEB_CAPTCHA_THRESHOLD=0.02

# Whale collector integration. Keep WHALE_ENABLED=false until web_raw and the
# collector API key have been created in Whale Admin.
WHALE_ENABLED=false
WHALE_BASE_URL=http://20.169.21.11
WHALE_COLLECTOR_API_KEY=
WHALE_AGENT_ID=realtime-web-search-01
WHALE_DATASET_ID=web_raw
WHALE_SOURCE_PLATFORM=google_search
WHALE_SOURCE_NAME=realtime-web-search
WHALE_SUPPORTED_TASK_TYPES=keyword_search
WHALE_MAX_CONCURRENCY=2
WHALE_CLAIM_LIMIT=2
WHALE_HEARTBEAT_SECONDS=20
WHALE_INGEST_BATCH_SIZE=50

# Continuous local seed mode. Set COLLECTOR_COMMAND=continuous-whale to have
# this project continuously crawl seed keywords and upload directly to Whale.
COLLECTOR_COMMAND=whale-worker
CONTINUOUS_WHALE_ENABLED=false
CONTINUOUS_DATE_SLICING_ENABLED=false
CONTINUOUS_AI_KEYWORDS=artificial intelligence,AI news,generative AI,OpenAI,AI regulation
CONTINUOUS_KEYWORD_EXPANSIONS=AI agents,AI chips,AI safety,enterprise AI,AI startups,machine learning,large language models,AI search,AI infrastructure,AI policy
CONTINUOUS_EXPAND_KEYWORDS=true
CONTINUOUS_INTERVAL_SECONDS=60
CONTINUOUS_MAX_ITEMS_PER_KEYWORD=1000000
CONTINUOUS_DAILY_TARGET=0
CONTINUOUS_KEYWORD_CONCURRENCY=8
CONTINUOUS_KEYWORD_CONCURRENCY_MAX=12
CONTINUOUS_KEYWORDS_PER_ROUND=24
ADAPTIVE_CONCURRENCY_ENABLED=true
ADAPTIVE_EVALUATION_SECONDS=300
CONTINUOUS_PROXY_PROFILE=private
CONTINUOUS_EXECUTOR=persistent
PERSISTENT_MAX_CRAWLS=12
OUTBOX_FLUSH_SECONDS=1
OUTBOX_MAX_PENDING=5000
