+
+// Diagnostic snapshots are opt-in, bounded and omit request/proxy headers.
+func saveDiagnosticPage(page *rod.Page) {
+ directory := os.Getenv("OPENSERP_DIAGNOSTIC_DIR")
+ if directory == "" || page == nil { return }
+ if os.MkdirAll(directory, 0700) != nil { return }
+ files, err := os.ReadDir(directory)
+ if err != nil || len(files) >= 40 { return }
+ html, err := page.HTML()
+ if err != nil { return }
+ file, err := os.CreateTemp(directory, "google-failed-*.html")
+ if err != nil { return }
+ defer file.Close()
+ _, _ = file.WriteString(html)
+}
