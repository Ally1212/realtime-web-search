--- /dev/null
+++ b/google/result_readiness_test.go
@@ -0,0 +1,18 @@
+package google
+import (
+ "strings"
+ "testing"
+ "github.com/PuerkitoBio/goquery"
+)
+func TestResultSelectorsRejectSearchShell(t *testing.T) {
+ shell := `<html><body><div data-hveid="share" data-ved="share" role="button">Share</div></body></html>`
+ doc, err := goquery.NewDocumentFromReader(strings.NewReader(shell))
+ if err != nil {t.Fatal(err)}
+ for _, selector := range searchResultSelectors() {
+  if doc.Find(selector).Length() != 0 {t.Fatal("search shell mistaken for a ready result")}
+ }
+ result := `<div data-hveid="result" data-ved="result"><a href="https://example.com/article"><h3>Article title</h3></a></div>`
+ doc, err = goquery.NewDocumentFromReader(strings.NewReader(result))
+ if err != nil {t.Fatal(err)}
+ if doc.Find(Selectors.ResultsBroad).Length() != 1 {t.Fatal("new-layout organic result rejected")}
+}
